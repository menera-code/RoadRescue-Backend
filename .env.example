# ---------------------------------------------------------------------------
# RoadRescue Backend — environment variables
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` to git.
# ---------------------------------------------------------------------------

# Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Firebase service account JSON.
# Get from: Firebase Console → ⚙️ Project Settings → Service Accounts tab
#           → "Generate new private key" → download the JSON file
#
# Two ways to provide it:
#   1. Save the JSON as `service-account.json` in this folder, and set:
#      FIREBASE_SERVICE_ACCOUNT_JSON=service-account.json
#   2. Paste the entire JSON content as a single-line string here.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Semaphore SMS key — get from https://semaphore.co
SEMAPHORE_API_KEY=

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# SMS provider settings
# ---------------------------------------------------------------------------
# SMS_PROVIDER=stub    → log-only (dev)
# SMS_PROVIDER=mocean  → real SMS via MOCEAN (production)
SMS_PROVIDER=stub

# MOCEAN credentials — get from https://moceanapi.com dashboard
# Leave blank to use stub mode (no real SMS sent)
# ---------------------------------------------------------------------------
# SMS — MOCEAN
# ---------------------------------------------------------------------------
# Leave MOCEAN_API_TOKEN blank to use stub mode (logs only, no real SMS)
MOCEAN_API_TOKEN=paste_your_token_here
MOCEAN_SENDER=MOCEAN

FRONTEND_URL=http://localhost:5173